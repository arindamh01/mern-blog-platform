NODE_ENV=development
PORT=5050
SERVER_URL=http://localhost:5050
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/mern-blog

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-32-chars
JWT_REFRESH_EXPIRES_DAYS=7

# Number of reverse proxies in front of the API (Vercel rewrite + Render = 2 in production)
TRUST_PROXY_HOPS=1

AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MIN=15

# OAuth (optional – the provider button is disabled server-side when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Seed script admin account
SEED_ADMIN_EMAIL=admin@blog.dev
SEED_ADMIN_PASSWORD=Admin@12345
